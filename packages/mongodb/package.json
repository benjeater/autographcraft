{
  "name": "@autographcraft/mongodb",
  "version": "1.6.0",
  "description": "MongoDB and Mongoose resolver implementations for AutoGraphCraft-generated GraphQL APIs",
  "keywords": [
    "autographcraft",
    "graphql",
    "graphql-api",
    "graphql-resolvers",
    "mongodb",
    "mongoose",
    "database",
    "code-generation",
    "typescript"
  ],
  "homepage": "https://github.com/benjeater/autographcraft#readme",
  "bugs": {
    "url": "https://github.com/benjeater/autographcraft/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benjeater/autographcraft.git",
    "directory": "packages/mongodb"
  },
  "license": "MIT",
  "author": "AutoGraphCraft <hello@autographcraft.com>",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/commonjs/app.js",
  "module": "./dist/esm/app.js",
  "types": "./dist/commonjs/app.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./README.md": "./README.md",
    "./README-*.md": "./README-*.md",
    ".": {
      "import": {
        "types": "./dist/esm/app.d.ts",
        "default": "./dist/esm/app.js"
      },
      "require": {
        "types": "./dist/commonjs/app.d.ts",
        "default": "./dist/commonjs/app.js"
      }
    }
  },
  "files": [
    "README.md",
    "README-*.md",
    "dist/**/*.*"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "compile": "tsc -b tsconfig.buildesm.json && tsc -b tsconfig.buildcjs.json && tsc-alias",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "testW": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "prepack": "npm run compile && npm test",
    "build": "npm run compile",
    "start": "npm run compile && dotenvx run --quiet -- node dist/esm/app.js",
    "startHot": "npm run compile && dotenvx run --quiet -- nodemon -q dist/esm/app.js",
    "startVerbose": "npm run compile && dotenvx run -- nodemon dist/esm/app.js,",
    "lint": "eslint"
  },
  "dependencies": {
    "@autographcraft/core": "^1.6.0",
    "graphql": "^17.0.2",
    "lodash.clonedeep": "^4.5.0",
    "mongoose": "^9.9.4"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.22.0",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.0",
    "@types/eslint": "^9.6.1",
    "@types/jest": "^30.0.0",
    "@types/lodash.clonedeep": "^4.5.9",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "jest": "^30.5.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "tsc-alias": "^1.9.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.68.0"
  }
}
